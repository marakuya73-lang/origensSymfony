{% extends 'base.html.twig' %}

{% block title %}{{ a.title }} · {{ a.reference }} — ORIGENS{% endblock %}
{% block description %}{{ a.lede ?: 'Registro individual de uma peça feita à mão no arquivo ORIGENS.' }}{% endblock %}
{% block meta %}
    <meta property="og:title" content="{{ a.title }} · {{ a.reference }} — ORIGENS">
    <meta property="og:description" content="{{ a.lede ?: 'Uma peça. Uma história.' }}">
    <meta property="og:type" content="article">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body %}
    {% set hero = a.images|first %}
    {% set alphabet = 'abcdefghijklmnopqrstuvwxyz' %}
    <div class="sheet">
        <header class="masthead">
            <div>
                <p class="wordmark">ORIGENS</p>
                <p class="label">Arquivo de peças</p>
            </div>
            <p class="label mast-aside">Registro <br class="only-small"> individual</p>
        </header>

        <main>
            <div class="hero">
                <figure class="hero-figure">
                    <img src="{{ asset(photo_src(hero, 1200)) }}" srcset="{{ asset(photo_src(hero, 400)) }} 400w, {{ asset(photo_src(hero, 1200)) }} 1200w, {{ asset(hero) }} 2000w" sizes="(max-width: 800px) 100vw, 36rem" width="1200" height="1500" alt="{{ a.title }} — fotografia da peça {{ a.reference }}">
                    <figcaption class="label figure-caption">
                        <span>Fig. 1 — vista frontal</span>
                        <span>{{ a.reference }}</span>
                    </figcaption>
                </figure>

                <div class="hero-copy">
                    <p class="label piece-ref">{{ a.reference }}</p>
                    <h1 class="piece-title">{{ a.title }}</h1>
                    {% if a.pending %}
                        <p class="lede">O texto desta peça ainda está sendo escrito.</p>
                    {% endif %}
                    {% if a.lede %}
                        <p class="lede" data-controller="read-aloud" data-action="click->read-aloud#toggle">{{ a.lede|nl2br }}</p>
                    {% endif %}

                    <dl class="meta-strip">
                        <div>
                            <dt class="label">Referência</dt>
                            <dd>{{ a.reference }}</dd>
                        </div>
                        <div>
                            <dt class="label">Dimensão</dt>
                            <dd>{{ a.dimensions }}</dd>
                        </div>
                    </dl>

                    {% if a.symbolism %}
                        <p class="symbolism" data-controller="read-aloud" data-action="click->read-aloud#toggle">{{ a.symbolism|nl2br }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="story">
                {% if a.images|length > 1 %}
                    <div class="gallery">
                        {% for image in a.images|slice(1) %}
                            <figure>
                                <img src="{{ asset(photo_src(image, 1200)) }}" srcset="{{ asset(photo_src(image, 400)) }} 400w, {{ asset(photo_src(image, 1200)) }} 1200w, {{ asset(image) }} 2000w" sizes="(max-width: 800px) 50vw, 20rem" width="800" height="1000" alt="{{ a.title }} — detalhe {{ loop.index }}" loading="lazy">
                                <figcaption class="label figure-caption">Fig. {{ loop.index + 1 }} — detalhe</figcaption>
                            </figure>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if a.materials is not empty %}
                <section class="section">
                    <div class="section-label">
                        <p class="label">§ 01</p>
                        <h2>A matéria</h2>
                    </div>
                    <div class="section-body">
                        <ul class="material-list">
                            {% for material in a.materials %}
                                <li>
                                    <span class="label">{{ alphabet|slice(loop.index0, 1) ?: loop.index }}.</span>
                                    <div>
                                        <p class="material-name">{{ material.name }}</p>
                                        {% if material.note %}
                                            <p class="quiet">{{ material.note|nl2br }}</p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </section>
                {% endif %}

                {% if a.handmade %}
                <section class="section">
                    <div class="section-label">
                        <p class="label">§ 02</p>
                        <h2>Feito à mão</h2>
                    </div>
                    <div class="section-body">
                        <p class="handmade">{{ a.handmade|nl2br }}</p>
                    </div>
                </section>
                {% endif %}

                {% if a.care is not empty %}
                <section class="section">
                    <div class="section-label">
                        <p class="label">§ 03</p>
                        <h2>Cuidados</h2>
                    </div>
                    <div class="section-body">
                        <ol class="care-list">
                            {% for line in a.care %}
                                <li>
                                    <span class="label">{{ '%02d'|format(loop.index) }}</span>
                                    <span>{{ line }}</span>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                </section>
                {% endif %}

                <section class="record-wrap">
                    <div class="record-card">
                        <p class="label">Registro desta peça</p>
                        <dl class="record-list">
                            <div><dt>Referência</dt><dd>{{ a.reference }}</dd></div>
                            <div><dt>Data do registro</dt><dd class="mono">{{ a.recordDate }}</dd></div>
                            <div><dt>Endereço</dt><dd class="mono address">{{ a.displayUrl }}</dd></div>
                        </dl>
                        <p class="record-note">
                            As informações aqui reunidas limitam-se aos detalhes documentados. Campos marcados como
                            <span class="pending">informação a documentar</span>
                            serão completados quando houver registro.
                        </p>
                    </div>
                </section>
            </div>
        </main>

        <footer class="colophon">
            <p class="motto">Uma peça. Uma história.</p>
            <p class="label">ORIGENS · {{ a.reference }}</p>
        </footer>
    </div>
{% endblock %}
