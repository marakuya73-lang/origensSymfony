{% macro svg(name) %}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
    {% if name == 'arrow-right' %}
        <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    {% elseif name == 'plus' %}
        <path d="M12 5v14M5 12h14"/>
    {% elseif name == 'pencil' %}
        <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/>
    {% elseif name == 'logout' %}
        <path d="M9 6H5v12h4"/><path d="M10 12h9M15 8l4 4-4 4"/>
    {% elseif name == 'trash' %}
        <path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M7 7l1 13h8l1-13"/>
    {% elseif name == 'upload' %}
        <path d="M12 16V5"/><path d="M8 9l4-4 4 4"/><path d="M5 19h14"/>
    {% elseif name == 'copy' %}
        <rect x="9" y="9" width="11" height="11"/><path d="M5 15V5h10"/>
    {% elseif name == 'check' %}
        <path d="M5 12.5l4.5 4.5L19 7"/>
    {% elseif name == 'arrow-up' %}
        <path d="M12 19V5"/><path d="M6 11l6-6 6 6"/>
    {% elseif name == 'arrow-down' %}
        <path d="M12 5v14"/><path d="M6 13l6 6 6-6"/>
    {% endif %}
</svg>
{% endmacro %}
